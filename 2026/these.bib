@incollection{GAIFMAN1967122,
  title = {Uniform Extension Operators for Models and Their Applications},
  booktitle = {Sets, Models and Recursion Theory},
  author = {Gaifman, Haim},
  editor = {Crossley, John N.},
  year = 1967,
  series = {Studies in Logic and the Foundations of Mathematics},
  volume = {46},
  pages = {122--155},
  publisher = {Elsevier},
  issn = {0049-237X},
  doi = {10.1016/S0049-237X(08)71505-2},
  abstract = {Publisher Summary A uniform extension operator is one which operates on models and yields, for every model in its domain, a proper elementary extension of it. The extensions are constructed in a ``uniform way'' with respect to all models in the domain of the operator. A uniform extension operator is based on a fixed set, \textohm{} of function symbols; and for every model in its domain, the elements added to the model will be just all the terms obtained by sticking its members into the empty places of the function symbols. If all the function symbols in \textohm{} have finitely many places then the operator is said to be a local extension operator. In this case, every added element depends on finitely many of the original elements. The chapter presents a simple example of a local extension operator. Another simple example concerning the same theory is of an operator based on an infinite set of zero-place function symbols, where a zero-place function symbol is regarded as a constant. This set is ordered by a fixed dense linear ordering, without first or last elements.}
}

