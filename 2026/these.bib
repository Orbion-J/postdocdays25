@article{bourkeAdjointFunctorTheorems2023,
  title = {Adjoint Functor Theorems for Homotopically Enriched Categories},
  author = {Bourke, John and Lack, Stephen and Vok{\v r}{\'i}nek, Luk{\'a}{\v s}},
  year = 2023,
  month = jan,
  journal = {Advances in Mathematics},
  volume = {412},
  eprint = {2006.07843},
  primaryclass = {math},
  pages = {108812},
  issn = {00018708},
  doi = {10.1016/j.aim.2022.108812},
  urldate = {2025-05-14},
  abstract = {We prove an adjoint functor theorem in the setting of categories enriched in a monoidal model category \$\textbackslash mathcal V\$ admitting certain limits. When \$\textbackslash mathcal V\$ is equipped with the trivial model structure this recaptures the enriched version of Freyd's adjoint functor theorem. For non-trivial model structures, we obtain new adjoint functor theorems of a homotopical flavour - in particular, when \$\textbackslash mathcal V\$ is the category of simplical sets we obtain a homotopical adjoint functor theorem appropriate to the \$\textbackslash infty\$-cosmoi of Riehl and Verity. We also investigate accessibility in the enriched setting, in particular obtaining homotopical cocompleteness results for accessible \$\textbackslash infty\$-cosmoi.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Category Theory}
}

@article{bourkeMonadsTheories2019,
  title = {Monads and Theories},
  author = {Bourke, John and Garner, Richard},
  year = 2019,
  month = jul,
  journal = {Advances in Mathematics},
  volume = {351},
  eprint = {1805.04346},
  primaryclass = {math},
  pages = {1024--1071},
  issn = {00018708},
  doi = {10.1016/j.aim.2019.05.016},
  urldate = {2025-04-01},
  abstract = {Given a locally presentable enriched category \$\textbackslash mathcal\textbraceleft E\textbraceright\$ together with a small dense full subcategory \$\textbackslash mathcal A\$ of arities, we study the relationship between monads on \$\textbackslash mathcal E\$ and identity-on-objects functors out of \$\textbackslash mathcal A\$, which we call \$\textbackslash mathcal A\$-pretheories. We show that the natural constructions relating these two kinds of structure form an adjoint pair. The fixpoints of the adjunction are characterised as the \$\textbackslash mathcal A\$-nervous monads---those for which the conclusions of Weber's nerve theorem hold---and the \$\textbackslash mathcal A\$-theories, which we introduce here. The resulting equivalence between \$\textbackslash mathcal A\$-nervous monads and \$\textbackslash mathcal A\$-theories is best possible in a precise sense, and extends almost all previously known monad--theory correspondences. It also establishes some completely new correspondences, including one which captures the globular theories defining Grothendieck weak \$\textbackslash omega\$-groupoids. Besides establishing our general correspondence and illustrating its reach, we study good properties of \$\textbackslash mathcal A\$-nervous monads and \$\textbackslash mathcal A\$-theories that allow us to recognise and construct them with ease. We also compare them with the monads with arities and theories with arities introduced and studied by Berger, Melli\textbackslash `es and Weber.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Category Theory}
}

@misc{brandenburgTensorCategoricalFoundations2014,
  title = {Tensor Categorical Foundations of Algebraic Geometry},
  author = {Brandenburg, Martin},
  year = 2014,
  month = oct,
  number = {arXiv:1410.1716},
  eprint = {1410.1716},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1410.1716},
  urldate = {2025-10-21},
  abstract = {Tannaka duality and its extensions by Lurie, Sch\textbackslash "appi et al. reveal that many schemes as well as algebraic stacks may be identified with their tensor categories of quasi-coherent sheaves. In this thesis we study constructions of cocomplete tensor categories (resp. cocontinuous tensor functors) which usually correspond to constructions of schemes (resp. their morphisms) in the case of quasi-coherent sheaves. This means to globalize the usual local-global algebraic geometry. For this we first have to develop basic commutative algebra in an arbitrary cocomplete tensor category. We then discuss tensor categorical globalizations of affine morphisms, projective morphisms, immersions, classical projective embeddings (Segre, Pl\textbackslash "ucker, Veronese), blow-ups, fiber products, classifying stacks and finally tangent bundles. It turns out that the universal properties of several moduli spaces or stacks translate to the corresponding tensor categories.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Algebraic Geometry,Mathematics - Category Theory}
}

