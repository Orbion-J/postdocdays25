@misc{fongRegularRelationalCategories2019,
  title = {Regular and Relational Categories: {{Revisiting}} '{{Cartesian}} Bicategories {{I}}'},
  shorttitle = {Regular and Relational Categories},
  author = {Fong, Brendan and Spivak, David I.},
  year = 2019,
  month = aug,
  number = {arXiv:1909.00069},
  eprint = {1909.00069},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1909.00069},
  urldate = {2025-03-18},
  abstract = {Regular logic is the fragment of first order logic generated by =, {$\top$}, {$\wedge$}, and {$\exists$}. A key feature of this logic is that it is the minimal fragment required to express composition of binary relations; another is that it is the internal logic of regular categories. The link between these two facts is that in any regular category, one may construct a notion of binary relation using jointly-monic spans; this results in what is known as the bicategory of relations of the regular category. In this paper we provide a direct axiomatization of bicategories of relations, which we term relational po-categories, reinterpreting the earlier work of Carboni and Walters along these lines. Our main contribution is an explicit proof that the 2-category of regular categories is equivalent to that of relational po-categories. Throughout, we emphasize the graphical nature of relational po-categories.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Category Theory}
}

@misc{fordMonadsCategoriesRelational2021,
  title = {Monads on {{Categories}} of {{Relational Structures}}},
  author = {Ford, Chase and Milius, Stefan and Schr{\"o}der, Lutz},
  year = 2021,
  month = jul,
  number = {arXiv:2107.03880},
  eprint = {2107.03880},
  primaryclass = {math},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2107.03880},
  urldate = {2025-04-15},
  abstract = {We introduce a framework for universal algebra in categories of relational structures given by finitary relational signatures and finitary or infinitary Horn theories, with the arity \$\textbackslash lambda\$ of a Horn theory understood as a strict upper bound on the number of premisses in its axioms; key examples include partial orders (\$\textbackslash lambda=\textbackslash omega\$) or metric spaces (\$\textbackslash lambda=\textbackslash omega\_1\$). We establish a bijective correspondence between \$\textbackslash lambda\$-accessible enriched monads on the given category of relational structures and a notion of \$\textbackslash lambda\$-ary algebraic theories (i.e. with operations of arity \${$<\backslash$}lambda\$), with the syntax of algebraic theories induced by the relational signature (e.g. inequations or equations-up-to-\$\textbackslash epsilon\$). We provide a generic sound and complete derivation system for such relational algebraic theories, thus in particular recovering (extensions of) recent systems of this type for monads on partial orders and metric spaces by instantiation. In particular, we present an \$\textbackslash omega\_1\$-ary algebraic theory of metric completion. The theory-to-monad direction of our correspondence remains true for the case of \$\textbackslash kappa\$-ary algebraic theories and \$\textbackslash kappa\$-accessible monads for \$\textbackslash kappa{$<\backslash$}lambda\$, e.g. for finitary theories over metric spaces.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Category Theory}
}

