@article{loregianCategoricalNotionsFibration2020,
  title = {Categorical Notions of Fibration},
  author = {Loregian, Fosco and Riehl, Emily},
  year = 2020,
  month = dec,
  journal = {Expositiones Mathematicae},
  volume = {38},
  number = {4},
  eprint = {1806.06129},
  primaryclass = {math},
  pages = {496--514},
  issn = {07230869},
  doi = {10.1016/j.exmath.2019.02.004},
  urldate = {2025-07-31},
  abstract = {Fibrations over a category B, introduced to category theory by Grothendieck, encode pseudo-functors Bop Cat, while the special case of discrete fibrations encode presheaves Bop {$\rightarrow$} Set. A twosided discrete variation encodes functors Bop \texttimes{} A {$\rightarrow$} Set, which are also known as profunctors from A to B. By work of Street, all of these fibration notions can be defined internally to an arbitrary 2-category or bicategory. While the two-sided discrete fibrations model profunctors internally to Cat, unexpectedly, the dual two-sided codiscrete cofibrations are necessary to model V-profunctors internally to V-Cat. These notes were initially written by the second-named author to accompany a talk given in the Algebraic Topology and Category Theory Proseminar in the fall of 2010 at the University of Chicago. A few years later, the first-named author joined to expand and improve the internal exposition and external references.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Category Theory}
}

